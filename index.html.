<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ZP10 Lerntrainer</title><style>body{font-family:-apple-system,BlinkMacSystemFont,sans-serif;background:#f5f7fb;margin:0;color:#172033}header{background:#fff;padding:24px;text-align:center}nav{display:flex;gap:8px;overflow:auto;padding:10px;background:#fff;position:sticky;top:0}button{border:0;border-radius:12px;padding:12px 15px;background:#e9edf5;font-size:15px}.primary{background:#315efb;color:#fff}main{max-width:800px;margin:auto;padding:16px}.card{background:#fff;border-radius:18px;padding:20px;margin:14px 0;box-shadow:0 2px 10px #0001}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px}.big{font-size:30px}.hidden{display:none}.choice{display:block;width:100%;text-align:left;margin:9px 0}.ok{background:#d9f7df!important}.bad{background:#ffe0e0!important}.muted{color:#667085}</style></head><body><header><h1>🎓 ZP10 Lerntrainer</h1><div>Mathe · Deutsch · Englisch – üben, testen und Fortschritt sammeln</div></header><nav><button onclick="show('home')">Start</button><button onclick="show('learn')">Lernen</button><button onclick="start()">Quiz</button><button onclick="start()">Prüfung</button><button onclick="show('progress')">Fortschritt</button></nav><main><section id="home"><div class="card">⭐ Punkte: <b id="points">0</b> &nbsp; 🔥 Serie: <b id="streak">0</b></div><div class="card"><h2>Dein ZP10-Training</h2><p>Wähle ein Fach und trainiere gezielt.</p><p class="muted">Dein Fortschritt wird in diesem Browser gespeichert.</p></div><div class="grid"><div class="card"><div class="big">📐</div><h2>Mathe</h2><p>Rechnen, Algebra, Funktionen, Geometrie und Wahrscheinlichkeit.</p><button class="primary" onclick="start('Mathe')">Mathe öffnen</button></div><div class="card"><div class="big">📖</div><h2>Deutsch</h2><p>Leseverstehen, Sprache, Analyse und Schreiben.</p><button class="primary" onclick="start('Deutsch')">Deutsch öffnen</button></div><div class="card"><div class="big">🇬🇧</div><h2>Englisch</h2><p>Grammar, vocabulary, reading, writing und mediation.</p><button class="primary" onclick="start('Englisch')">Englisch öffnen</button></div></div><div class="card"><h2>Schnellstart</h2><button class="primary" onclick="start()">🎯 10er-Quiz</button> <button onclick="start()">⏱️ Prüfungssimulation</button></div></section><section id="learn" class="hidden"><div class="card"><h2>📚 Lernen</h2><p><b>Mathe:</b> Terme, Gleichungen, Funktionen, Geometrie und Wahrscheinlichkeit.</p><p><b>Deutsch:</b> Leseverstehen, Sprache, Analyse und Schreiben.</p><p><b>Englisch:</b> Grammar, vocabulary, reading, writing und mediation.</p></div></section><section id="quiz" class="hidden"><div class="card"><h2 id="title">Quiz</h2><p id="question"></p><div id="choices"></div><p id="feedback"></p><button id="next" class="primary hidden" onclick="nextQ()">Nächste Aufgabe</button></div></section><section id="progress" class="hidden"><div class="card"><h2>📈 Fortschritt</h2><p>⭐ Punkte: <b id="p2">0</b></p><p>🔥 Serie: <b id="s2">0</b></p><p>Richtig: <b id="c2">0</b></p></div></section></main><script>const qs=[['Mathe','Wie viel ist 7 · 8?',['54','56','64','48'],1],['Mathe','Löse: x + 9 = 15',['x = 4','x = 5','x = 6','x = 7'],2],['Mathe','Wie viel sind 25 % von 80?',['10','20','25','40'],1],['Deutsch','Welche Wortart ist „schnell“ in „Der Hund läuft schnell“?',['Nomen','Verb','Adjektiv/Adverb','Artikel'],2],['Deutsch','Was ist eine Metapher?',['Ein sachlicher Bericht','Ein bildhafter Ausdruck','Eine Frage','Ein Reim'],1],['Englisch','Choose the correct form: She ___ to school every day.',['go','goes','going','gone'],1],['Englisch','What is the past tense of „go“?',['goed','goes','went','gone'],2],['Englisch','Choose: I have ___ my homework.',['do','did','done','doing'],2]];let pts=+localStorage.pts||0,st=+localStorage.st||0,cor=+localStorage.cor||0,list=[],i=0;function save(){localStorage.pts=pts;localStorage.st=st;localStorage.cor=cor;points.textContent=pts;streak.textContent=st;p2.textContent=pts;s2.textContent=st;c2.textContent=cor}function show(id){document.querySelectorAll('main section').forEach(s=>s.classList.add('hidden'));document.getElementById(id).classList.remove('hidden');save()}function start(sub){list=(sub?qs.filter(q=>q[0]==sub):[...qs]).sort(()=>Math.random()-.5).slice(0,10);i=0;show('quiz');render()}function render(){if(i>=list.length){question.textContent='🎉 Geschafft!';choices.innerHTML='';feedback.textContent='Quiz beendet.';next.classList.add('hidden');return}let q=list[i];title.textContent=q[0]+' – Aufgabe '+(i+1)+'/'+list.length;question.textContent=q[1];feedback.textContent='';next.classList.add('hidden');choices.innerHTML=q[2].map((x,n)=>'<button class="choice" onclick="answer('+n+')">'+x+'</button>').join('')}function answer(n){let q=list[i],b=[...document.querySelectorAll('.choice')];b.forEach(x=>x.disabled=true);if(n===q[3]){b[n].classList.add('ok');feedback.textContent='✅ Richtig!';pts+=10;st++;cor++}else{b[n].classList.add('bad');b[q[3]].classList.add('ok');feedback.textContent='❌ Richtig wäre: '+q[2][q[3]];st=0}save();next.classList.remove('hidden')}function nextQ(){i++;render()}save();</script></body></html>
